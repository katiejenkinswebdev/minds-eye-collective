# Copy to .env.local and fill in. Secrets live here and in Vercel only, never in git.
#
# Every var below is optional in development: with none of them set the site runs
# and the contact form returns success, logging the lead to the server console
# instead of persisting it. In production, a lead that reaches neither Supabase
# nor Resend returns a 500 rather than silently disappearing.

# Supabase — durable record of every lead. Service role key is server-side only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Resend — notification email. The domain must be verified in Resend before
# sending from it. Verify mindseyecollective.ai, which puts Resend's MX and SPF
# on the send. subdomain and leaves Hover's root MX forwarding intact.
RESEND_API_KEY=

# Where new leads are delivered. This is the Hover forwarding address.
CONTACT_TO_EMAIL=hello@mindseyecollective.ai

# Sender. Must be on the Resend-verified domain. Kept separate from the inbox
# above so replies land on hello@ rather than a no-reply mailbox.
CONTACT_FROM_EMAIL=Minds Eye Collective <noreply@mindseyecollective.ai>
